{
  "opencollection": "1.0.0",
  "info": {
    "name": "ChannelShipper & Royal Mail Public Labels Returns API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Returns",
        "type": "folder"
      },
      "items": [
