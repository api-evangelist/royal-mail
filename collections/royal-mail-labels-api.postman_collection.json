          "request": {
            "name": "Return a single PDF file with generated label and/or associated document(s)",
            "description": {
              "content": "Reserved for OBA customers only.\n\nThe account \"Label format\" settings page will control the page format settings used to print the postage label\nand associated documents.\n",
