                  "disabled": false,
                  "key": "documentType",
                  "value": "<string>",
                  "description": "(Required) Document generation mode."
                },
                {
                  "disabled": false,
                  "key": "includeReturnsLabel",
                  "value": "<boolean>",
                  "description": "Include returns label. Required when documentType is set to 'postageLabel'."
                },
                {
                  "disabled": false,
                  "key": "includeCN",
                  "value": "<boolean>",
                  "description": "Include CN22/CN23 with label."
                }
